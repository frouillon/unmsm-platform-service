# Copiar a .env y ajustar si hace falta:
#   cp .env.example .env

DB_PASSWORD=root
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80

# Orígenes permitidos si el frontend llama al backend en otro host/puerto.
# Con el compose por defecto el FE usa nginx y proxy /api (mismo origen).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

