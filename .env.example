# Copiar a .env y ajustar si hace falta:
#   cp .env.example .env
#
# Local / Docker de desarrollo: deja SPRING_PROFILES_ACTIVE vacío (defaults OK).
# Cloud / demo pública: SPRING_PROFILES_ACTIVE=prod y define las variables obligatorias.

DB_PASSWORD=root
# Si ya tienes MySQL local en 3306, deja 3307 (solo afecta acceso desde el host).
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=80

# Orígenes permitidos si el frontend llama al backend en otro host/puerto.
# Con el compose por defecto el FE usa nginx y proxy /api (mismo origen).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# En cloud genera uno propio (Base64, mínimo 256 bits). No reutilices el de ejemplo.
JWT_SECRET=FAtZEQgt9DoTfroMggQgC4TeYLGSK/HL6cJflW+WBaQNpOpaC2DML5X7qvFe6amE
JWT_EXPIRATION_MINUTES=480
APP_TIMEZONE=America/Lima
APP_PUBLIC_URL=http://localhost:8080
SEED_ENABLED=true
DEMO_PASSWORD=SanMarcos2026

# Vacío = perfil local. En cloud: prod
SPRING_PROFILES_ACTIVE=
